{
  "name": "conflicting-report",
  "description": "Re-submitting a mixed report with one duplicate and one conflicting outcome returns [duplicate, conflict], persists only the conflict once (omitting duplicate), and leaves accepted results unchanged.",
  "min_lease_ttl_ms": 1000,
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "init",
        "build_id": "build-6",
        "runner_id": "runner-a",
        "machine_index": 0,
        "config": {"machines": 1, "lease_ttl_ms": 5000, "build_timeout_ms": 60000, "max_attempts": 3, "max_batch": 2},
        "tests": ["tests/a.py", "tests/b.py", "tests/c.py"],
        "predictions_ms": [100, 100, 100]
      },
      "expect_status": 200,
      "expect_events": ["initialized"]
    },
    {
      "now_ms": 1000,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 200,
      "expect_events": ["leased"],
      "expect_response": {
        "status": "leased",
        "lease_id": 1,
        "attempts": [
          {"attempt_id": "0.1", "test_index": 0, "generation": 1, "test": "tests/a.py"},
          {"attempt_id": "1.1", "test_index": 1, "generation": 1, "test": "tests/b.py"}
        ]
      }
    },
    {
      "now_ms": 2000,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 1,
        "results": [
          {"attempt_id": "0.1", "test_index": 0, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 100},
          {"attempt_id": "1.1", "test_index": 1, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 150}
        ]
      },
      "expect_status": 200,
      "expect_events": ["reported"]
    },
    {
      "now_ms": 2100,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 1,
        "results": [
          {"attempt_id": "0.1", "test_index": 0, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 100},
          {"attempt_id": "1.1", "test_index": 1, "generation": 1, "outcome": "failed", "timed": false, "duration_ms": 0}
        ]
      },
      "expect_status": 200,
      "expect_events": ["reported"],
      "expect_response": {
        "verdict": "running",
        "results": [
          {"attempt_id": "0.1", "test_index": 0, "generation": 1, "disposition": "duplicate"},
          {"attempt_id": "1.1", "test_index": 1, "generation": 1, "disposition": "conflict"}
        ]
      }
    },
    {
      "now_ms": 2200,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 1,
        "results": [
          {"attempt_id": "0.1", "test_index": 0, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 100},
          {"attempt_id": "1.1", "test_index": 1, "generation": 1, "outcome": "failed", "timed": false, "duration_ms": 0}
        ]
      },
      "expect_status": 200,
      "expect_events": [],
      "expect_response": {
        "verdict": "running",
        "results": [
          {"attempt_id": "0.1", "test_index": 0, "generation": 1, "disposition": "duplicate"},
          {"attempt_id": "1.1", "test_index": 1, "generation": 1, "disposition": "conflict"}
        ]
      }
    },
    {
      "now_ms": 2300,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a2"},
      "expect_status": 200,
      "expect_events": ["leased"]
    },
    {
      "now_ms": 2400,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 2,
        "results": [
          {"attempt_id": "2.1", "test_index": 2, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 90}
        ]
      },
      "expect_status": 200,
      "expect_events": ["reported"],
      "expect_response": {"verdict": "passed"}
    }
  ],
  "expect_final": {
    "verdict": "passed",
    "counts": {"total": 3, "pending": 0, "leased": 0, "passed": 3, "failed": 0, "skipped": 0, "unresolved": 0},
    "conflicts_len": 0,
    "conflicts_truncated": false,
    "tests": [
      {"test_index": 0, "state": "passed", "generation": 1, "timed": true, "duration_ms": 100, "history_len": 0, "history_truncated": false},
      {"test_index": 1, "state": "passed", "generation": 1, "timed": true, "duration_ms": 150, "history_len": 1, "history_truncated": false},
      {"test_index": 2, "state": "passed", "generation": 1, "timed": true, "duration_ms": 90, "history_len": 0, "history_truncated": false}
    ]
  }
}
