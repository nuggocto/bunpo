{
  "name": "stale-lease-request",
  "description": "Repeating a request_id after its lease expired or was reported returns 409 stale_request.",
  "min_lease_ttl_ms": 1000,
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "init",
        "build_id": "build-9",
        "runner_id": "runner-a",
        "machine_index": 0,
        "config": {"machines": 1, "lease_ttl_ms": 4000, "build_timeout_ms": 60000, "max_attempts": 3, "max_batch": 1},
        "tests": ["tests/a.py", "tests/b.py"],
        "predictions_ms": [200, 100]
      },
      "expect_status": 200,
      "expect_events": ["initialized"]
    },
    {
      "now_ms": 1000,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 200,
      "expect_events": ["leased"]
    },
    {
      "now_ms": 5000,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 409,
      "expect_error_code": "stale_request",
      "expect_events": ["expired"]
    },
    {
      "now_ms": 5100,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a2"},
      "expect_status": 200,
      "expect_events": ["leased"],
      "expect_response": {
        "status": "leased",
        "lease_id": 2,
        "attempts": [{"attempt_id": "1.1", "test_index": 1, "generation": 1, "test": "tests/b.py"}]
      }
    },
    {
      "now_ms": 5200,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 2,
        "results": [{"attempt_id": "1.1", "test_index": 1, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 80}]
      },
      "expect_status": 200,
      "expect_events": ["reported"]
    },
    {
      "now_ms": 5300,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a2"},
      "expect_status": 409,
      "expect_error_code": "stale_request",
      "expect_events": []
    }
  ],
  "expect_final": {
    "verdict": "running",
    "counts": {"total": 2, "pending": 1, "leased": 0, "passed": 1, "failed": 0, "skipped": 0, "unresolved": 0},
    "conflicts_len": 0,
    "conflicts_truncated": false,
    "tests": [
      {"test_index": 0, "state": "pending", "generation": 1, "timed": false, "duration_ms": 0, "history_len": 0, "history_truncated": false},
      {"test_index": 1, "state": "passed", "generation": 1, "timed": true, "duration_ms": 80, "history_len": 0, "history_truncated": false}
    ]
  }
}
