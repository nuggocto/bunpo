{
  "name": "init-conflict-after-passed",
  "description": "A mismatched init arriving after the build already passed still persists a conflicted event and flips the verdict from passed to unresolved.",
  "min_lease_ttl_ms": 1000,
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "init",
        "build_id": "build-13",
        "runner_id": "runner-a",
        "machine_index": 0,
        "config": {"machines": 2, "lease_ttl_ms": 5000, "build_timeout_ms": 60000, "max_attempts": 3, "max_batch": 1},
        "tests": ["tests/a.py"],
        "predictions_ms": [100]
      },
      "expect_status": 200,
      "expect_events": ["initialized"]
    },
    {
      "now_ms": 1100,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 200,
      "expect_events": ["leased"]
    },
    {
      "now_ms": 1200,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 1,
        "results": [{"attempt_id": "0.1", "test_index": 0, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 50}]
      },
      "expect_status": 200,
      "expect_events": ["reported"],
      "expect_response": {"verdict": "passed"}
    },
    {
      "now_ms": 1300,
      "command": {
        "type": "init",
        "build_id": "build-13",
        "runner_id": "runner-b",
        "machine_index": 1,
        "config": {"machines": 2, "lease_ttl_ms": 5000, "build_timeout_ms": 60000, "max_attempts": 3, "max_batch": 1},
        "tests": ["tests/a.py", "tests/b.py"],
        "predictions_ms": [100, 200]
      },
      "expect_status": 409,
      "expect_error_code": "init_conflict",
      "expect_events": ["conflicted"]
    },
    {
      "now_ms": 1400,
      "command": {"type": "status"},
      "expect_status": 200,
      "expect_events": [],
      "expect_response": {
        "verdict": "unresolved",
        "finished_at_ms": 1200,
        "conflicts_truncated": false
      }
    }
  ],
  "expect_final": {
    "verdict": "unresolved",
    "counts": {"total": 1, "pending": 0, "leased": 0, "passed": 1, "failed": 0, "skipped": 0, "unresolved": 0},
    "conflicts_len": 1,
    "conflicts_truncated": false,
    "tests": [
      {"test_index": 0, "state": "passed", "generation": 1, "timed": true, "duration_ms": 50, "history_len": 0, "history_truncated": false}
    ]
  }
}
