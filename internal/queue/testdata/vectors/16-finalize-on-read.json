{
  "name": "finalize-on-read",
  "description": "GET status writes nothing when expiry keeps the build running, but persists an expired or finalized event the moment expiry transitions the verdict to terminal.",
  "min_lease_ttl_ms": 1000,
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "init",
        "build_id": "build-16",
        "runner_id": "runner-a",
        "machine_index": 0,
        "config": {"machines": 1, "lease_ttl_ms": 5000, "build_timeout_ms": 20000, "max_attempts": 2, "max_batch": 1},
        "tests": ["tests/a.py"],
        "predictions_ms": [100]
      },
      "expect_status": 200,
      "expect_events": ["initialized"]
    },
    {
      "now_ms": 1000,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 200,
      "expect_events": ["leased"]
    },
    {
      "now_ms": 7000,
      "command": {"type": "status"},
      "expect_status": 200,
      "expect_events": [],
      "expect_response": {"verdict": "running", "finished_at_ms": null}
    },
    {
      "now_ms": 7100,
      "command": {"type": "lease", "runner_id": "runner-b", "machine_index": 1, "request_id": "b1"},
      "expect_status": 200,
      "expect_events": ["expired", "leased"]
    },
    {
      "now_ms": 13000,
      "command": {"type": "status"},
      "expect_status": 200,
      "expect_events": ["expired"],
      "expect_response": {"verdict": "unresolved", "finished_at_ms": 13000}
    },
    {
      "now_ms": 13100,
      "command": {
        "type": "report",
        "runner_id": "runner-b",
        "lease_id": 2,
        "results": [{"attempt_id": "0.2", "test_index": 0, "generation": 2, "outcome": "passed", "timed": true, "duration_ms": 80}]
      },
      "expect_status": 200,
      "expect_events": ["reported"],
      "expect_response": {
        "verdict": "unresolved",
        "results": [{"attempt_id": "0.2", "test_index": 0, "generation": 2, "disposition": "stale"}]
      }
    }
  ],
  "expect_final": {
    "verdict": "unresolved",
    "counts": {"total": 1, "pending": 0, "leased": 0, "passed": 0, "failed": 0, "skipped": 0, "unresolved": 1},
    "conflicts_len": 0,
    "conflicts_truncated": false,
    "tests": [
      {"test_index": 0, "state": "unresolved", "generation": 2, "timed": false, "duration_ms": 0, "history_len": 1, "history_truncated": false}
    ]
  }
}
