{
  "name": "heartbeat-after-deadline",
  "description": "A runner heartbeating after its own lease deadline with no other calls in between gets held=false, emits expired, and a later report is recorded as stale.",
  "min_lease_ttl_ms": 1000,
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "init",
        "build_id": "build-18",
        "runner_id": "runner-a",
        "machine_index": 0,
        "config": {"machines": 1, "lease_ttl_ms": 4000, "build_timeout_ms": 60000, "max_attempts": 3, "max_batch": 1},
        "tests": ["tests/a.py"],
        "predictions_ms": [200]
      },
      "expect_status": 200,
      "expect_events": ["initialized"]
    },
    {
      "now_ms": 1000,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 200,
      "expect_events": ["leased"],
      "expect_response": {"status": "leased", "lease_id": 1, "deadline_ms": 5000}
    },
    {
      "now_ms": 5000,
      "command": {"type": "heartbeat", "runner_id": "runner-a", "lease_id": 1},
      "expect_status": 200,
      "expect_events": ["expired"],
      "expect_response": {"held": false, "deadline_ms": 0, "verdict": "running"}
    },
    {
      "now_ms": 5100,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 1,
        "results": [{"attempt_id": "0.1", "test_index": 0, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 180}]
      },
      "expect_status": 200,
      "expect_events": ["reported"],
      "expect_response": {
        "verdict": "running",
        "results": [{"attempt_id": "0.1", "test_index": 0, "generation": 1, "disposition": "stale"}]
      }
    }
  ],
  "expect_final": {
    "verdict": "running",
    "counts": {"total": 1, "pending": 1, "leased": 0, "passed": 0, "failed": 0, "skipped": 0, "unresolved": 0},
    "conflicts_len": 0,
    "conflicts_truncated": false,
    "tests": [
      {"test_index": 0, "state": "pending", "generation": 1, "timed": false, "duration_ms": 0, "history_len": 1, "history_truncated": false}
    ]
  }
}
