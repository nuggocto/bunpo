{
  "name": "wait-before-expected-end",
  "description": "Before active leases reach their latest predicted end, wait returns min(latest - now, earliest_deadline - now) clamped to [1000, max_wait].",
  "min_lease_ttl_ms": 10000,
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "init",
        "build_id": "build-wait-before",
        "runner_id": "runner-a",
        "machine_index": 0,
        "config": {"machines": 2, "lease_ttl_ms": 60000, "build_timeout_ms": 300000, "max_attempts": 3, "max_batch": 1},
        "tests": ["tests/a.py", "tests/b.py"],
        "predictions_ms": [8000, 14000]
      },
      "expect_status": 200,
      "expect_events": ["initialized"]
    },
    {
      "now_ms": 1000,
      "command": {"type": "lease", "runner_id": "runner-a", "machine_index": 0, "request_id": "a1"},
      "expect_status": 200,
      "expect_events": ["leased"],
      "expect_response": {"status": "leased", "lease_id": 1, "deadline_ms": 61000}
    },
    {
      "now_ms": 2000,
      "command": {"type": "lease", "runner_id": "runner-b", "machine_index": 1, "request_id": "b1"},
      "expect_status": 200,
      "expect_events": ["leased"],
      "expect_response": {"status": "leased", "lease_id": 2, "deadline_ms": 62000}
    },
    {
      "now_ms": 5000,
      "command": {"type": "lease", "runner_id": "runner-c", "machine_index": 2, "request_id": "c1"},
      "expect_status": 200,
      "expect_events": [],
      "expect_response": {"status": "wait", "retry_after_ms": 10000}
    },
    {
      "now_ms": 14500,
      "command": {"type": "lease", "runner_id": "runner-c", "machine_index": 2, "request_id": "c2"},
      "expect_status": 200,
      "expect_events": [],
      "expect_response": {"status": "wait", "retry_after_ms": 1000}
    },
    {
      "now_ms": 15000,
      "command": {
        "type": "report",
        "runner_id": "runner-a",
        "lease_id": 1,
        "results": [{"attempt_id": "1.1", "test_index": 1, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 14000}]
      },
      "expect_status": 200,
      "expect_events": ["reported"]
    },
    {
      "now_ms": 15100,
      "command": {
        "type": "report",
        "runner_id": "runner-b",
        "lease_id": 2,
        "results": [{"attempt_id": "0.1", "test_index": 0, "generation": 1, "outcome": "passed", "timed": true, "duration_ms": 8000}]
      },
      "expect_status": 200,
      "expect_events": ["reported"],
      "expect_response": {"verdict": "passed"}
    },
    {
      "now_ms": 15500,
      "command": {"type": "lease", "runner_id": "runner-c", "machine_index": 2, "request_id": "c3"},
      "expect_status": 200,
      "expect_events": [],
      "expect_response": {"status": "done", "verdict": "passed"}
    }
  ],
  "expect_final": {
    "verdict": "passed",
    "counts": {"total": 2, "pending": 0, "leased": 0, "passed": 2, "failed": 0, "skipped": 0, "unresolved": 0},
    "conflicts_len": 0,
    "conflicts_truncated": false,
    "tests": [
      {"test_index": 0, "state": "passed", "generation": 1, "timed": true, "duration_ms": 8000, "history_len": 0, "history_truncated": false},
      {"test_index": 1, "state": "passed", "generation": 1, "timed": true, "duration_ms": 14000, "history_len": 0, "history_truncated": false}
    ]
  }
}
