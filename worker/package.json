{
  "name": "bunpo-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "WRANGLER_SEND_METRICS=false wrangler types",
    "typecheck": "WRANGLER_SEND_METRICS=false wrangler types && tsc --noEmit",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:do": "WRANGLER_SEND_METRICS=false vitest run --config vitest.do.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
