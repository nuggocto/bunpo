{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bunpo-queue",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    // Local benchmark default under the 10 ms Free-plan CPU assumption;
    // valid range is 1..20000 and may be raised after testing on a real account.
    "MAX_TESTS": "5000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUILD_DO",
        "class_name": "BuildDO"
      },
      {
        "name": "BUILD_INDEX",
        "class_name": "BuildIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BuildDO", "BuildIndex"]
    }
  ]
}
