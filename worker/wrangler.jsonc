{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bunpo-queue",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    // Default build size cap (valid range 1..20000). 21 builds of 20,000 files
    // were created and answered every request on a real Cloudflare Free-plan
    // account; 5000 stays the default for Worker fetch CPU margin on large
    // bodies and daily row writes. See docs/trials/2026-11-25-cloudflare-free-trial.md.
    "MAX_TESTS": "5000"
  },
  "assets": {
    "directory": "../internal/dashboard/static",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUILD_DO",
        "class_name": "BuildDO"
      },
      {
        "name": "BUILD_INDEX",
        "class_name": "BuildIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BuildDO", "BuildIndex"]
    }
  ]
}
